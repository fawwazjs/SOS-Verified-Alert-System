# ==================================================================
# .env.example - salin menjadi .env lalu isi nilainya
# JANGAN PERNAH meng-commit file .env (sudah masuk .gitignore).
# ==================================================================

# Supabase PostgreSQL - Session Pooler (Settings > Database > Connection string)
# Contoh:
# postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-xx-xx.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Mode debug Flask (1 untuk pengembangan, 0 di production/Render)
FLASK_DEBUG=1

# Port lokal (Render akan menimpa dengan PORT-nya sendiri)
PORT=5000
